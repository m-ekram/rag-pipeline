# ---------------------------------------------------------------------------
# Provider: "local" (default), "google", or "openai"
#
# The defaults in this file are fully local: no API key, no quota, no network.
# Fetch the chat model once before starting:
#
#     python scripts/fetch_local_model.py
#
# The embedding model downloads itself on first use (~130 MB).
# ---------------------------------------------------------------------------
LLM_PROVIDER=local

# Embedding and chat are configured independently; this defaults to
# LLM_PROVIDER. Local embeddings with a hosted chat model is a sensible mix: it
# removes the quota wall that actually bites while keeping answers fast.
EMBED_PROVIDER=local

# ---------------------------------------------------------------------------
# Local models
# ---------------------------------------------------------------------------
CHAT_MODEL=models/qwen2.5-3b-instruct-q4_k_m.gguf
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBED_DEVICE=cpu

# llama.cpp. n_ctx must hold the system prompt plus TOP_K passages plus the
# answer; 4096 is comfortable for 5 chunks of ~1000 chars.
LLAMA_N_CTX=4096
LLAMA_MAX_TOKENS=512
# LLAMA_N_THREADS=          # defaults to your CPU count
# LLAMA_N_BATCH=512

TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Hosted providers (optional)
#
# Vectors from different embedding models are not comparable, so re-run
# ingestion after switching:   python -m app.ingest --rebuild
# ---------------------------------------------------------------------------
# LLM_PROVIDER=google        # -> gemini-flash-latest / models/gemini-embedding-001
# GOOGLE_API_KEY=            # https://aistudio.google.com/apikey
#
# LLM_PROVIDER=openai        # -> gpt-4o-mini / text-embedding-3-small
# OPENAI_API_KEY=            # https://platform.openai.com/api-keys

# ---------------------------------------------------------------------------
# Citations
#   model  trust the LLM to emit [n] markers (fine for hosted models)
#   auto   compute attribution when the model emits none. Default when local,
#          because models this small reliably ignore the instruction.
#   off    never annotate; the source panel still lists what was retrieved
# ---------------------------------------------------------------------------
# CITATION_MODE=auto
# CITE_THRESHOLD=0.55

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
DATA_DIR=data
INDEX_DIR=faiss_index

# ---------------------------------------------------------------------------
# Chunking / retrieval - the knobs you tune against eval/evaluate.py
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
FETCH_K=20
# 1.0 = pure relevance, which makes MMR a no-op. Measured as harmful on this
# corpus at 0.5: -5.5 points of hit@5 and -20 of precision. Lower it only for a
# corpus with genuine near-duplicate documents.
MMR_LAMBDA=1.0
USE_HYBRID=true
WEIGHT_DENSE=0.6
WEIGHT_SPARSE=0.4

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# Client-side requests-per-minute cap. 0 disables throttling, which is correct
# for local embedding. The free Google tier caps embedding at 100/min, so
# hosted providers default to 90.
# EMBED_RPM=0
# EMBED_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Set this to your real origin before exposing the service publicly.
ALLOWED_ORIGINS=*
