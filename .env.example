# ---------------------------------------------------------------------------
# Provider: "openai" (default), "local" (offline), or "google"
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Defaults per provider (override with CHAT_MODEL / EMBEDDING_MODEL):
#   openai -> gpt-4o-mini / text-embedding-3-small
#   local  -> models/qwen2.5-3b-instruct-q4_k_m.gguf / snowflake/snowflake-arctic-embed-m
#   google -> gemini-flash-latest / models/gemini-embedding-001
# CHAT_MODEL=
# EMBEDDING_MODEL=
TEMPERATURE=0.0

# Embeddings can use a different provider from chat. EMBED_PROVIDER=local runs
# arctic-embed-m on ONNX Runtime (CPU, no key, no quota) while chat stays on OpenAI.
# Re-run ingestion after changing the embedding model.
# EMBED_PROVIDER=local

# Only for LLM_PROVIDER=google / EMBED_PROVIDER=google
# GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
DATA_DIR=data
INDEX_DIR=faiss_index

# ---------------------------------------------------------------------------
# Chunking / retrieval - these are the knobs you tune against eval/evaluate.py
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
HEADER_MODE=path-clean
TOP_K=5
FETCH_K=20
MMR_LAMBDA=1.0
USE_HYBRID=true
# Lexical leg: splade (better ranking, model pass per chunk at ingest) or bm25 (fast)
SPARSE=splade
WEIGHT_DENSE=0.6
WEIGHT_SPARSE=0.4
# RERANK=false
# RERANK_MODEL=BAAI/bge-reranker-base
# RERANK_FETCH_K=30

# Loader processes for ingestion; 0 = auto (parallel only for large corpora)
INGEST_WORKERS=0

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Set to your real origin(s) before exposing the service publicly.
ALLOWED_ORIGINS=*
