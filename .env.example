# ---------------------------------------------------------------------------
# Provider: "google" (free tier, default) or "openai"
# ---------------------------------------------------------------------------
LLM_PROVIDER=google

# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Only needed when LLM_PROVIDER=openai
# OPENAI_API_KEY=

# Override the defaults if you want:
#   google -> gemini-flash-latest / models/gemini-embedding-001
#   openai -> gpt-4o-mini / text-embedding-3-small
# CHAT_MODEL=
# EMBEDDING_MODEL=
TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# Embeddings run locally (bge-small-en-v1.5, CPU) so ingestion has no quota
# and re-indexing during eval tuning is free. Chat stays on Gemini.
# ---------------------------------------------------------------------------
# EMBED_PROVIDER=local   # uncomment for local, quota-free embeddings
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBED_DEVICE=cpu


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
DATA_DIR=data
INDEX_DIR=faiss_index

# ---------------------------------------------------------------------------
# Chunking / retrieval - these are the knobs you tune against eval/evaluate.py
# ---------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
FETCH_K=20
MMR_LAMBDA=1.0
USE_HYBRID=true
WEIGHT_DENSE=0.6
WEIGHT_SPARSE=0.4

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*
