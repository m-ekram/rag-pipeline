# Virtual Environment
ragenv311/
venv/
env/
.venv/
# Anchored to the repo root: these are virtualenv directories. Unanchored,
# `lib/` and `bin/` match at any depth and silently swallow web/lib, web/bin, etc.
/lib/
/lib64/
/bin/
/include/

